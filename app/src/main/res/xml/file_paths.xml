<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Covers getExternalFilesDir("logs")/tr-lb-debug.log for the FileProvider share. -->
    <external-files-path name="logs" path="logs/"/>
    <!-- Covers getExternalFilesDir(null)/updates/*.apk for the self-update installer. -->
    <external-files-path name="apk_update" path="updates/"/>
    <!-- Covers getCacheDir()/exports/ride-*.csv|json for the ride-log FileProvider share. -->
    <cache-path name="exports" path="exports/"/>
    <!-- Covers the public Downloads folder for the update APK/firmware share on API < 29. -->
    <external-path name="downloads" path="Download/"/>
</paths>
